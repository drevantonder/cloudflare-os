{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gatekeeper-llm-vision",
  "main": ".wrangler/validate/src/worker.ts",
  "build": {
    "command": "pnpm run prepare:mupdf && pnpm exec capnweb-validate build --out .wrangler/validate",
    "watch_dir": "src",
  },
  "compatibility_date": "2026-02-02",
  "compatibility_flags": ["allow_irrevocable_stub_storage", "nodejs_compat"],
  "rules": [
    { "type": "Text", "globs": ["**/*.txt"], "fallthrough": false },
    { "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": false },
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["VisionGatekeeper"] },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false },
  },
}
